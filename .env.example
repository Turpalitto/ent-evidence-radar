# ------------------------------------------------------------
# ENT Evidence Radar — переменные окружения (все опциональны).
# Скопируйте в `.env.local` (не попадает в git) при необходимости.
# ------------------------------------------------------------

# База данных.
# ● НЕ задана — используется встроенный PostgreSQL (PGlite) с файловым хранилищем в `./.pglite`.
#   Просто и без внешних зависимостей; данные живут в каталоге проекта.
# ● Задана — подключается внешний PostgreSQL (рекомендуется для продакшена):
#   переживает перезапуск/краш, закладки и заметки не теряются, нет само-очистки БД.
#   Схема создаётся автоматически при старте (drizzle migrate).
DATABASE_URL=

# API-ключ NCBI E-utilities (бесплатный: https://www.ncbi.nlm.nih.gov/account/settings/).
# Без ключа — лимит 3 запроса/с к PubMed; с ключом — до 10 запросов/с (быстрее, реже HTTP 429).
NCBI_API_KEY=

# Базовый URL развёрнутого приложения. Используется из GitHub Actions (.github/workflows/refresh.yml),
# которое по cron дёргает POST /api/refresh, когда приложение запущено на serverless без своего cron.
APP_URL=http://localhost:3001
