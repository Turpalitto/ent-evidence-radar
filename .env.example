# Пример переменных окружения. Скопируйте в .env.local и настройте под себя.

# --- База данных ---
# Если переменная НЕ задана — используется встроенный PostgreSQL (PGlite), хранится в папке .pglite/.
# Для внешнего PostgreSQL (Supabase / Neon / RDS / локальный) — раскомментируйте и укажите строку подключения:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- PubMed (NCBI E-utilities) ---
# API-ключ NCBI повышает лимит частоты запросов (≤10 req/s вместо ≤3 req/s).
# Получить: https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-ncbi-e-utilities/
NCBI_API_KEY=
