# ===== AI =====
# Провайдер для ИИ-перевода и резюме аннотаций.
# По умолчанию: OpenRouter (работает из РФ без VPN, есть бесплатные модели).
# Сменить провайдера = поменять AI_BASE_URL + AI_MODEL (код менять не надо).

# Ключ OpenRouter (https://openrouter.ai/keys)
AI_API_KEY=

# Базовый URL API. Для OpenRouter оставляйте как есть.
AI_BASE_URL=https://openrouter.ai/api/v1

# Модель. Бесплатные модели помечены ":free" (стоят $0, но есть rate-limit).
AI_MODEL=deepseek/deepseek-chat:free

# Альтернатива DeepSeek напрямую (свой ключ, чуть лучше качество):
#   AI_BASE_URL=https://api.deepseek.com
#   AI_MODEL=deepseek-chat
#   и вместо AI_API_KEY задать DEEPSEEK_API_KEY=...
DEEPSEEK_API_KEY=
