# ENT Evidence Radar — переменные окружения

# --- База данных ---
# Оставьте пустым, чтобы использовать встроенный PostgreSQL (PGlite) в ./pglite.
# Укажите, чтобы подключиться к внешнему PostgreSQL (миграции применяются автоматически,
# данные переживают перезапуск; PGlite-каталог может повреждаться при жёстком падении).
DATABASE_URL=

# --- API для источников ---
# Ключ NCBI E-utilities. Публично доступен без ключа (до ~3 запросов/сек);
# с ключом лимит повышается до ~10 запросов/сек (помогает при массовой загрузке PubMed).
# Необязательно для локальной работы.
NCBI_API_KEY=

# --- Внешний курируемый refresh (GitHub Actions cron) ---
# URL, на который workflow дёргает POST /api/refresh (и /api/digest).
# Заполняется как секрет в Settings -> Secrets and variables -> Actions (например, APP_URL).
APP_URL=

# --- Еженедельный email-дайджест (SMTP) ---
# Нужен только если планируете рассылать дайджест. Если не задан — работает dry-run:
# POST /api/digest не шлёт письмо, а лишь логирует и возвращает ok.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Отправитель; если пусто — используется SMTP_USER.
SMTP_FROM=
# Получатели через запятую (например: "a@example.com, b@example.com").
DIGEST_RECIPIENTS=
